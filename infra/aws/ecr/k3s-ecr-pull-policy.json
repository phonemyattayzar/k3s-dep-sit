{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GetECRAuthorizationToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullAllowedApplicationRepositories",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": [
        "arn:aws:ecr:ap-southeast-1:051131628511:repository/k3s-dep-dat",
        "arn:aws:ecr:ap-southeast-1:051131628511:repository/sar-mel-backend",
        "arn:aws:ecr:ap-southeast-1:051131628511:repository/sar-mel-frontend"
      ]
    }
  ]
}
